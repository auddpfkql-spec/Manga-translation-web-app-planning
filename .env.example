# ─── 이 파일을 .env 로 복사한 뒤 값을 채우세요 (.env 는 git 에 커밋되지 않습니다) ───

# Gemini API 키  →  https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ngrok authtoken  →  https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_token_here

# 서버 설정
HOST=0.0.0.0
PORT=8000

# 모델 캐시 경로 (Colab 예: /content/models)
MODEL_DIR=./models
HF_HOME=./models/hf

# 번역 설정
TARGET_LANG=ko
GEMINI_MODEL=gemini-2.0-flash

# 서버 시작 시 모델 미리 로드(콜드스타트 단축). true/false
WARMUP_ON_STARTUP=false
